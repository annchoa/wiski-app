{
	"name": "wiski-api",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun --watch src/index.ts",
		"typeorm": "bun ./node_modules/typeorm/cli.js -d src/data-source.ts",
		"migration:generate": "bun run typeorm migration:generate",
		"migration:run": "bun run typeorm migration:run",
		"migration:revert": "bun run typeorm migration:revert",
		"type-check": "tsc",
		"test": "bun test",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check --write ."
	},
	"engines": {
		"node": "^22.18.0 || >=24.12.0"
	},
	"dependencies": {
		"express": "^5.3.0",
		"pg": "^8.23.1",
		"reflect-metadata": "^0.2.2",
		"typeorm": "^1.1.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.2",
		"@tsconfig/node24": "^24.0.6",
		"@types/bun": "^1.4.5",
		"@types/express": "^5.0.6",
		"@types/pg": "^8.23.1",
		"typescript": "^7.0.2"
	}
}
